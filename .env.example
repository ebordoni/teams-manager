# Copy this file to .env for local development.

# Optional: override the local data directory (defaults to ./data in dev)
# DATA_DIR=./data

# Optional: backend port for local dev (defaults to 3002)
# PORT=3002

# Google OAuth 2.0 (Fase 5 — generazione documenti, non ancora richiesto per l'MVP)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3002/api/google/oauth/callback

# AI per i piani partita (configura almeno la chiave del provider scelto)
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_FALLBACK_PROVIDERS=google,groq
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
