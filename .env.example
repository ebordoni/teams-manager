# Copy this file to .env for local development.

# Optional: override the local data directory (defaults to ./data in dev)
# DATA_DIR=./data

# Optional: backend port for local dev (defaults to 3002)
# PORT=3002

# Google OAuth 2.0 (Fase 5 — generazione documenti, non ancora richiesto per l'MVP)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3002/api/google/oauth/callback
